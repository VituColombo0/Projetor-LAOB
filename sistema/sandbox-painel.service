[Unit]
Description=Painel do celular para a caixa de areia (Projetor-LAOB)
After=graphical-session.target

[Service]
ExecStart=%h/SARndbox-rosto/venv/bin/python %h/SARndbox-rosto/painel.py
WorkingDirectory=%h/SARndbox-rosto
Restart=always
RestartSec=10
# A areia (SARndbox) aberta por este serviço não pode morrer junto com ele: sem isto o systemd
# matava a areia quando o vigia terminava a checagem (ela ficava abrindo e fechando a cada 2 min)
# e quando o painel reiniciava. Sem Nice: a areia herdaria a prioridade menor.
KillMode=process

[Install]
WantedBy=default.target
