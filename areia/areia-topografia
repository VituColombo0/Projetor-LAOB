#!/bin/bash
# Volta a caixa de areia para a TOPOGRAFIA (relevo colorido com a animação do tema; se a versão
# com Foto falhar, o SARndbox original entra no lugar). É também o que roda ao ligar o PC
# (~/.config/autostart/SARndbox.desktop): espera o Kinect aparecer e tenta de novo se não abrir.
# Não depende do venv: a topografia abre mesmo que a parte de fotos esteja quebrada.
# Com a areia já aberta leva uns 0,2 s (só manda os comandos); abrindo do zero, uns 10 s.
set -uo pipefail
D=$(dirname "$(readlink -f "$0")")
LOG=$D/inicio.log
registra() { echo "$(date '+%F %T') $*" >> "$LOG"; }
if [ -f "$LOG" ] && [ "$(wc -l < "$LOG")" -gt 500 ]; then
  tail -n 200 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

# Kinect (Xbox NUI Camera 045e:02ae): ao ligar o PC ele pode demorar alguns segundos.
# Com a versão com Foto aberta o Kinect já está em uso: não precisa procurar.
if [ "$("$D/sandbox.sh" estado)" != rosto ]; then
  for _ in $(seq 1 30); do
    lsusb -d 045e:02ae >/dev/null 2>&1 && break
    sleep 1
  done
  if ! lsusb -d 045e:02ae >/dev/null 2>&1; then
    registra "Kinect não encontrado (USB)"
    echo "Kinect não encontrado: confira o cabo USB e a fonte do Kinect"
  fi
fi

python3 "$D/areia.py" marca-topografia 2>/dev/null || registra "não consegui anotar o estado"
# (o papel de parede não é mais refeito aqui: o timer atualizar-papel-parede e o painel ao abrir cuidam dele)

# 23/11/2026: sem o "sleep 2" fixo depois de cada tentativa (era quase todo o tempo da troca, 2,2 s). O
# sandbox.sh já espera o programa subir e confere que ele ficou de pé; a resposta diz o que abriu:
# "topografia" (a versão com Foto, com os comandos entregues) ou "original" (a reserva).
for tentativa in 1 2 3; do
  saida=$("$D/sandbox.sh" topografia 2>&1)
  case "${saida##*$'\n'}" in   # a última linha
    topografia)
      registra "topografia aberta (tentativa $tentativa)"
      echo "Topografia no projetor."
      exit 0 ;;
    original)
      if [ "$("$D/sandbox.sh" estado)" = original ]; then
        registra "topografia de RESERVA no projetor (o SARndbox original, sem efeitos): a versão com Foto não subiu (tentativa $tentativa); o vigia tenta de novo a cada 10 min"
        echo "Topografia de reserva no projetor (sem os efeitos): a versão com Foto não abriu. Veja $D/sandbox.falhou.log"
        exit 0
      fi ;;
  esac
  registra "topografia não abriu (tentativa $tentativa): ${saida//$'\n'/; }"
  sleep 5
done
echo "A topografia não abriu depois de 3 tentativas. Veja: $LOG"
exit 1
